          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"/>
          <stringProp name="parameters"/>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">import java.util.concurrent.ThreadLocalRandom
int minAmt = Integer.parseInt(vars.get(&quot;ssMinAmount&quot;) ?: &quot;20&quot;)
int maxAmt = Integer.parseInt(vars.get(&quot;ssMaxAmount&quot;) ?: &quot;200&quot;)
int amt = ThreadLocalRandom.current().nextInt(minAmt, maxAmt + 1)
vars.put(&quot;randomAmount&quot;, String.valueOf(amt))
</stringProp>
        </JSR223PreProcessor>
