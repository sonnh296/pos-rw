      <!-- ============ Phase 7 - Chaos / Availability test ============ -->
      <!-- Phase 7 dùng chung endpoint với P5 nhưng chạy song song với script chaos bên ngoài.
           Mục tiêu: verify circuit breaker Redis → MySQL fallback khi Redis chết giữa load. -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="P7 Chaos virtual lock (run with chaos/redis-down.sh)" enabled="false">
        <stringProp name="ThreadGroup.num_threads">100</stringProp>
