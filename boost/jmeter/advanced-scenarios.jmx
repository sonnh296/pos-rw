                <stringProp name="Argument.value">{&quot;customerId&quot;:&quot;stress-user-${__Random(1,${stressProfileCount},)}&quot;,&quot;transactionId&quot;:&quot;txn-stress-2000-${__threadNum}-${__counter(TRUE,)}&quot;,&quot;amount&quot;:${__Random(${stressMinAmount},${stressMaxAmount},)}}</stringProp>
