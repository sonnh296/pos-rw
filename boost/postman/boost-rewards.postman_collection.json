{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "Boost — Rewards API",
		"description": "Production: POST /api/rewards/checkout. Demo: /api/rewards/demo/* (app.demo.enabled=true).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "customerId",
			"value": "customer-001"
		},
		{
			"key": "transactionId",
			"value": "txn-postman-001"
		}
	],
	"item": [
		{
			"name": "POST checkout (production)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"transactionId\": \"{{transactionId}}\",\n  \"amount\": 100.0\n}"
				},
				"url": "{{baseUrl}}/api/rewards/checkout",
				"description": "Virtual thread + lock + idempotency + outbox. 409 on duplicate txnId."
			}
		},
		{
			"name": "GET current points",
			"request": {
				"method": "GET",
				"header": [],
